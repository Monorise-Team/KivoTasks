{
  "openapi": "3.1.0",
  "info": {
    "title": "KivoTasks API",
    "version": "0.0.0",
    "summary": "API produktu KivoTasks (zadania i projekty Monorise): stan usługi oraz sesja przeglądarki.",
    "description": "Opis API KivoTasks (`/api/v1/*`) wygenerowany automatycznie z kodu (katalog ścieżek i schematy Zod). Wszystkie odpowiedzi ustawiają nagłówek `Cache-Control: no-store` i używają koperty `{ data, meta, error }` (ADR-0044). Tożsamość osoby i firmy zawsze wynika z tokenu albo sesji MonoriseCore (ADR-0037).",
    "license": {
      "name": "Proprietary, all rights reserved",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://kivo.localhost:3500",
      "description": "Lokalnie"
    },
    {
      "url": "https://kivo.monorise.studio",
      "description": "Produkcja"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Stan usługi KivoTasks."
    },
    {
      "name": "Session",
      "description": "Dane zalogowanej osoby, firmy i możliwości widoczne w przeglądarce (BFF)."
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Stan usługi KivoTasks",
        "description": "Publiczna kontrola zdrowia serwera API bez sprawdzania bazy danych i MonoriseCore.",
        "responses": {
          "200": {
            "description": "Usługa działa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Session"
        ],
        "operationId": "getMe",
        "summary": "Zalogowana osoba, firma i możliwości w KivoTasks",
        "description": "Zwraca profil osoby i firmy pobrany z MonoriseCore (`GET /core/v1/me`) oraz pole `capabilities` wyliczone z migawki uprawnień produktu `kivotasks`. Dostępne wyłącznie przez sesję BFF przeglądarki (ciasteczko); wywołania z tokenem Bearer otrzymują `403 PERMISSION_DENIED`, bo profil osoby i firmy pobierają bezpośrednio z Core API.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil zalogowanej osoby, firma i możliwości w interfejsie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Brak albo nieważny token dostępu albo wygasła sesja (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Brak dostępu do produktu albo brak uprawnienia (PERMISSION_DENIED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Usługa zależna (MonoriseCore) chwilowo niedostępna (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token dostępu użytkownika JWT (EdDSA) z auth.monorise.studio z odbiorcą API KivoTasks (ADR-0023)."
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-monorise-session",
        "description": "Sesja BFF przeglądarki w ciasteczku HttpOnly (__Host-monorise-session w produkcji, monorise-session na http://localhost; ADR-0050). Żądania mutujące wymagają zgodnego nagłówka Origin."
      }
    },
    "schemas": {
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "ApiErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "null"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ]
      },
      "ApiMeta": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "hasProductAccess": {
            "type": "boolean"
          },
          "readIssues": {
            "type": "boolean"
          },
          "writeIssues": {
            "type": "boolean"
          },
          "manageTeams": {
            "type": "boolean"
          },
          "manageProjects": {
            "type": "boolean"
          }
        },
        "required": [
          "hasProductAccess",
          "readIssues",
          "writeIssues",
          "manageTeams",
          "manageProjects"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "UNAUTHENTICATED",
          "PERMISSION_DENIED",
          "PRODUCT_ACCESS_REQUIRED",
          "NOT_FOUND",
          "VALIDATION_FAILED",
          "CONFLICT",
          "RATE_LIMITED",
          "INTERNAL_ERROR"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Health"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email"
            ]
          },
          "employee": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "fullName": {
                "type": "string"
              },
              "jobTitle": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "firstName",
              "lastName",
              "fullName",
              "jobTitle"
            ]
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          }
        },
        "required": [
          "account",
          "employee",
          "organization",
          "capabilities"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Me"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "data",
          "meta",
          "error"
        ]
      }
    }
  }
}
