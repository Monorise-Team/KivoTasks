{
  "name": "@kivotasks/web",
  "version": "0.0.0",
  "private": true,
  "description": "kivo.monorise.studio (strona produktu i API) oraz kivotasks.monorise.studio (aplikacja w przeglądarce)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3500",
    "build": "next build",
    "start": "next start --port 3500",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "pnpm --filter @kivotasks/contracts build && node scripts/generate-openapi.mjs",
    "openapi:check": "pnpm --filter @kivotasks/contracts build && node scripts/generate-openapi.mjs --check",
    "permissions:register": "pnpm --filter @kivotasks/contracts build && node scripts/register-permissions.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@kivotasks/client": "workspace:*",
    "@kivotasks/contracts": "workspace:*",
    "@kivotasks/db": "workspace:*",
    "@monorise-team/auth": "0.0.1-dev.28",
    "@monorise-team/events": "0.0.1-dev.28",
    "@monorise-team/permissions": "0.0.1-dev.28",
    "@monorise-team/sdk": "0.0.1-dev.28",
    "@monorise-team/ui": "0.0.1-dev.28",
    "jose": "^6.2.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@monorise-team/config": "0.0.1-dev.28",
    "@monorise-team/testing": "0.0.1-dev.28",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
