// Baza kivo_tasks (ADR-0096, ADR-0103): sesje przeglądarki, kanał zdarzeń Core, domena zadań (etap 1a)
// oraz domena współpracy (etap 2a: komentarze, wzmianki, reakcje, historia, obserwujący i skrzynka).
// Osoba, pracownik i firma pochodzą z MonoriseCore (sub, employee_id i org_id z tokenu), więc KivoTasks nie ma własnych kont.
// Schemat "auth": sesje przeglądarki (BFF, @monorise-team/auth). Szukamy ich po skrócie identyfikatora z ciasteczka,
// zanim wiadomo, czyja to sesja, więc są bez RLS; tokeny w środku są zaszyfrowane.
// Schemat "public": funkcje pomocnicze RLS (migracje), tabele techniczne kanału zdarzeń Core bez danych firmowych
// oraz tabele domenowe z wymuszonym RLS (ENABLE + FORCE ROW LEVEL SECURITY) na public.current_organization_id()
// i złożonymi kluczami obcymi przypiętymi do firmy i zespołu.
// Aplikacja łączy się rolą kivo_tasks_app bez uprawnień właściciela tabel (ADR-0037).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum WorkflowStateCategory {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED

  @@schema("public")
}

enum IssueRelationType {
  BLOCKS
  RELATED
  DUPLICATE

  @@schema("public")
}

enum IssueEventType {
  CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATE_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  LABELS_CHANGED
  DUE_DATE_CHANGED
  ESTIMATE_CHANGED
  PARENT_CHANGED
  RELATION_ADDED
  RELATION_REMOVED
  DELETED

  @@schema("public")
}

enum InboxItemKind {
  ASSIGNED
  MENTIONED
  COMMENTED

  @@schema("public")
}

/// Sesja przeglądarki: tokeny z Core zaszyfrowane po stronie serwera (ADR-0050).
model Session {
  /// SHA-256 identyfikatora z ciasteczka; samego identyfikatora baza nie zna.
  id             String   @id
  /// Konto Monorise (sub z tokenu Core).
  accountId      String   @map("account_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  /// Zaszyfrowane tokeny, kontekst firmy i dane osoby.
  data           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("auth")
}

/// Kursor ostatnio przetworzonego zdarzenia z kanału HTTP produktu (bez danych firmowych, bez RLS).
model EventFeedCursor {
  /// Nazwa kanału zdarzeń, np. "core".
  id        String   @id
  /// Numer ostatnio przetworzonego zdarzenia (liczba dziesiętna jako napis).
  sequence  String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_feed_cursors")
  @@schema("public")
}

/// Zapis przetworzonych zdarzeń do deduplikacji po stronie odbiorcy (bez danych firmowych, bez RLS).
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
  @@schema("public")
}

/// Zespół KivoTasks oparty na jednostce organizacyjnej MonoriseCore (id = unitId w Core).
model Team {
  /// Identyfikator jednostki organizacyjnej w MonoriseCore.
  id              String          @id @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  /// Krótki klucz zespołu do numeracji zadań (2-5 wielkich liter A-Z, np. MAG).
  key             String
  /// Nazwa skopiowana z jednostki Core i odświeżana best-effort.
  name            String
  /// Kolejny numer zadania do przydzielenia atomowo w transakcji tworzenia zadania.
  nextIssueNumber Int             @default(1) @map("next_issue_number")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  workflowStates  WorkflowState[]
  labels          Label[]
  issues          Issue[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, archivedAt])
  @@map("teams")
  @@schema("public")
}

/// Status obiegu zadań należący do zespołu.
model WorkflowState {
  id             String                @id @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  teamId         String                @map("team_id") @db.Uuid
  name           String
  category       WorkflowStateCategory
  color          String
  position       Int
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?             @map("archived_at") @db.Timestamptz(3)
  team           Team                  @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  issues         Issue[]

  @@unique([organizationId, teamId, id])
  @@index([organizationId, teamId, position])
  @@index([teamId, archivedAt])
  @@map("workflow_states")
  @@schema("public")
}

/// Etykieta zespołu (unikalna w zespole bez rozróżniania wielkości liter dla aktywnych rekordów).
model Label {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  teamId         String       @map("team_id") @db.Uuid
  name           String
  color          String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  team           Team         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  issueLabels    IssueLabel[]

  @@unique([organizationId, teamId, id])
  @@map("labels")
  @@schema("public")
}

/// Zadanie zespołu KivoTasks (identyfikator KEY-number, miękkie usuwanie przez deleted_at).
model Issue {
  id                String                    @id @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  teamId            String                    @map("team_id") @db.Uuid
  number            Int
  title             String
  description       String?
  stateId           String                    @map("state_id") @db.Uuid
  /// Priorytet jak w Linear: 0 brak, 1 pilny, 2 wysoki, 3 średni, 4 niski.
  priority          Int                       @default(0) @db.SmallInt
  assigneeAccountId String?                   @map("assignee_account_id") @db.Uuid
  creatorAccountId  String                    @map("creator_account_id") @db.Uuid
  dueDate           DateTime?                 @map("due_date") @db.Date
  estimate          Int?                      @db.SmallInt
  parentId          String?                   @map("parent_id") @db.Uuid
  sortOrder         Float                     @default(0) @map("sort_order")
  startedAt         DateTime?                 @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?                 @map("completed_at") @db.Timestamptz(3)
  canceledAt        DateTime?                 @map("canceled_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  /// Kolumna generowana PostgreSQL (konfiguracja 'simple', tytuł waga A, opis waga B) z indeksem GIN.
  searchVector      Unsupported("tsvector")?  @map("search_vector")
  team              Team                      @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  state             WorkflowState             @relation(fields: [organizationId, teamId, stateId], references: [organizationId, teamId, id], onDelete: Restrict)
  parent            Issue?                    @relation("IssueHierarchy", fields: [organizationId, teamId, parentId], references: [organizationId, teamId, id], onDelete: Restrict)
  children          Issue[]                   @relation("IssueHierarchy")
  issueLabels       IssueLabel[]
  outgoingRelations IssueRelation[]           @relation("IssueOutgoingRelations")
  incomingRelations IssueRelation[]           @relation("IssueIncomingRelations")
  comments          IssueComment[]
  events            IssueEvent[]
  subscribers       IssueSubscriber[]
  inboxItems        InboxItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, teamId, id])
  @@unique([teamId, number])
  @@index([organizationId, teamId, deletedAt])
  @@index([organizationId, stateId, deletedAt])
  @@index([organizationId, assigneeAccountId, deletedAt])
  @@index([organizationId, parentId, deletedAt])
  @@index([organizationId, priority, updatedAt])
  @@index([organizationId, dueDate])
  @@index([organizationId, updatedAt])
  @@index([organizationId, createdAt])
  @@index([teamId, sortOrder])
  @@index([searchVector], type: Gin)
  @@map("issues")
  @@schema("public")
}

/// Powiązanie zadania z etykietą tego samego zespołu.
model IssueLabel {
  issueId        String @map("issue_id") @db.Uuid
  labelId        String @map("label_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  issue          Issue  @relation(fields: [organizationId, teamId, issueId], references: [organizationId, teamId, id], onDelete: Cascade)
  label          Label  @relation(fields: [organizationId, teamId, labelId], references: [organizationId, teamId, id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([organizationId, teamId, labelId])
  @@index([organizationId, labelId])
  @@map("issue_labels")
  @@schema("public")
}

/// Relacja między dwoma zadaniami w obrębie firmy (dozwolone relacje między zespołami).
model IssueRelation {
  id             String            @id @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  issueId        String            @map("issue_id") @db.Uuid
  relatedIssueId String            @map("related_issue_id") @db.Uuid
  type           IssueRelationType
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  issue          Issue             @relation("IssueOutgoingRelations", fields: [organizationId, issueId], references: [organizationId, id], onDelete: Cascade)
  relatedIssue   Issue             @relation("IssueIncomingRelations", fields: [organizationId, relatedIssueId], references: [organizationId, id], onDelete: Cascade)

  @@unique([issueId, relatedIssueId, type])
  @@index([organizationId, issueId])
  @@index([organizationId, relatedIssueId])
  @@map("issue_relations")
  @@schema("public")
}

/// Komentarz w zadaniu KivoTasks (Markdown 1–10 000 znaków, miękkie usuwanie przez deleted_at).
model IssueComment {
  id              String            @id @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  teamId          String            @map("team_id") @db.Uuid
  issueId         String            @map("issue_id") @db.Uuid
  authorAccountId String            @map("author_account_id") @db.Uuid
  body            String
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  editedAt        DateTime?         @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(3)
  issue           Issue             @relation(fields: [organizationId, teamId, issueId], references: [organizationId, teamId, id], onDelete: Cascade)
  mentions        CommentMention[]
  reactions       CommentReaction[]
  inboxItems      InboxItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, issueId, id])
  @@index([organizationId, issueId, createdAt, id], map: "issue_comments_org_issue_created_idx")
  @@index([organizationId, teamId])
  @@map("issue_comments")
  @@schema("public")
}

/// Wzmianka (@mention) zweryfikowanego członka zespołu z aktywnym kontem w komentarzu.
model CommentMention {
  commentId      String       @map("comment_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  comment        IssueComment @relation(fields: [organizationId, commentId], references: [organizationId, id], onDelete: Cascade)

  @@id([commentId, accountId])
  @@index([organizationId, commentId])
  @@index([organizationId, accountId])
  @@map("comment_mentions")
  @@schema("public")
}

/// Reakcja emoji (stały zestaw 👍 ❤️ 🎉 😄 👀 🚀) na komentarzu.
model CommentReaction {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  commentId      String       @map("comment_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  emoji          String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  comment        IssueComment @relation(fields: [organizationId, commentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([commentId, accountId, emoji])
  @@index([organizationId, commentId])
  @@map("comment_reactions")
  @@schema("public")
}

/// Wpis historii zmian zadania (zapisywany w tej samej transakcji co zmiana zadania).
model IssueEvent {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  teamId         String         @map("team_id") @db.Uuid
  issueId        String         @map("issue_id") @db.Uuid
  actorAccountId String         @map("actor_account_id") @db.Uuid
  type           IssueEventType
  before         Json?          @db.JsonB
  after          Json?          @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  issue          Issue          @relation(fields: [organizationId, teamId, issueId], references: [organizationId, teamId, id], onDelete: Cascade)

  @@index([organizationId, issueId, createdAt, id], map: "issue_events_org_issue_created_idx")
  @@index([organizationId, teamId])
  @@map("issue_events")
  @@schema("public")
}

/// Osoba obserwująca zadanie (otrzymuje wpisy COMMENTED w skrzynce powiadomień).
model IssueSubscriber {
  issueId        String   @map("issue_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  issue          Issue    @relation(fields: [organizationId, issueId], references: [organizationId, id], onDelete: Cascade)

  @@id([issueId, accountId])
  @@index([organizationId, issueId])
  @@index([organizationId, accountId])
  @@map("issue_subscribers")
  @@schema("public")
}

/// Powiadomienie w skrzynce KivoTasks (przypisanie, wzmianka albo nowy komentarz).
model InboxItem {
  id                 String        @id @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  recipientAccountId String        @map("recipient_account_id") @db.Uuid
  kind               InboxItemKind
  issueId            String        @map("issue_id") @db.Uuid
  actorAccountId     String        @map("actor_account_id") @db.Uuid
  commentId          String?       @map("comment_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt             DateTime?     @map("read_at") @db.Timestamptz(3)
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(3)
  issue              Issue         @relation(fields: [organizationId, issueId], references: [organizationId, id], onDelete: Cascade)
  comment            IssueComment? @relation(fields: [organizationId, issueId, commentId], references: [organizationId, issueId, id], onDelete: Cascade)

  @@index([organizationId, recipientAccountId, createdAt, id], map: "inbox_items_recipient_created_idx")
  @@index([organizationId, issueId])
  @@index([organizationId, commentId])
  @@map("inbox_items")
  @@schema("public")
}
