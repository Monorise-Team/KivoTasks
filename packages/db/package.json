{
  "name": "@kivotasks/db",
  "version": "0.0.0",
  "private": true,
  "description": "Baza kivo_tasks: schemat Prisma, migracje z RLS i pomocnik pracy w imieniu osoby i firmy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:deploy:test": "DATABASE_URL=${KIVOTASKS_TEST_DATABASE_URL:-postgresql://kivo_tasks_owner:kivo_tasks_owner@localhost:5436/kivo_tasks_test} prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@monorise-team/config": "0.0.1-dev.25",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.15.0",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
